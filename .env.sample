EMAIL=user@email.org
NEXTCLOUD_TRUSTED_DOMAINS=trusted.domain.fr:8443
OVERWRITEHOST=trusted.domain.fr:8443
OVERWRITECLIURL=https://trusted.domain.fr:8443
MYSQL_ROOT_PASSWORD=root_password
MYSQL_PASSWORD=password
CLOUDFLARE_API_TOKEN=cloudflare_api_token

# Configuration Scaleway Object Storage
SCW_REMOTE="scaleway"
SCW_BUCKET="nextcloud-backup"
SCW_PATH="nextcloud"
SCW_STORAGE_CLASS="GLACIER"

# Configuration S3
SCW_ACCESS_KEY="VOTRE_ACCESS_KEY"
SCW_SECRET_KEY="VOTRE_SECRET_KEY"
SCW_REGION="fr-par"
SCW_ENDPOINT="https://s3.fr-par.scw.cloud"